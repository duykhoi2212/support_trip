# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/final_project_db?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-minimum-32-characters-change-in-production"
JWT_EXPIRES_IN="7d"

# External API Services
# OpenRouteService API Key (Sign up at https://openrouteservice.org/)
ORS_API_KEY="your_openrouteservice_api_key_here"

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# File Upload Configuration
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# SMTP Email Configuration (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="support_trip <your-email@gmail.com>"
FRONTEND_URL="http://localhost:3000"
