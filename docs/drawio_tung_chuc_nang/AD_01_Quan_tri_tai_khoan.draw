            <mxPoint x="610" y="332" as="sourcePoint" />
            <mxPoint x="850" y="332" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_17" value="5. Tạo Notification thông báo tài khoản đã được mở khóa cho User" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1">
