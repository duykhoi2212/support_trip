            <mxPoint x="130" y="167" as="sourcePoint" />
            <mxPoint x="370" y="167" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_12" value="2. Nhấn &apos;Mở khóa tài khoản&apos; và nhập lý do can thiệp" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="217" as="sourcePoint" />
            <mxPoint x="370" y="217" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_13" value="3. Gửi yêu cầu mở khóa (POST /admin/users/:id/unlock)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="267" as="sourcePoint" />
            <mxPoint x="610" y="267" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_14" value="Nếu" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=50;height=22;fillColor=none;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="302" width="880" height="375" as="geometry" />
        </mxCell>
        <mxCell id="c_15" value="[Có nhập lý do can thiệp bắt buộc]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="108" y="304" width="560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c_16" value="4. Đổi User = ACTIVE, thu hồi ViPham = REVOKED &amp; ghi AuditLog" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1">
