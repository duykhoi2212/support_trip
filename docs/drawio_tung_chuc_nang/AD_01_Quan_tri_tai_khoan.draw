            <mxPoint x="850" y="122" as="sourcePoint" />
            <mxPoint x="850" y="707" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_11" value="1. Chọn tài khoản bị khóa, xem chi tiết tỷ lệ hủy và vi phạm" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1">
