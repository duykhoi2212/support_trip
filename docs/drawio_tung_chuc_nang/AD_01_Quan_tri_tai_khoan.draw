        <mxCell id="c_22" value="8. Phản hồi lỗi 400 (Bắt buộc nhập lý do mở khóa)" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=open;endFill=0;endSize=8;dashed=1;" edge="1" parent="1">
