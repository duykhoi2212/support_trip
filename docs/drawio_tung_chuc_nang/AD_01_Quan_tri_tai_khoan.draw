<mxfile host="app.diagrams.net">
  <diagram id="AD-01" name="Sơ đồ tuần tự: Quản trị tài khoản">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="767" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" value="Sơ đồ tuần tự: Quản trị tài khoản &amp; Mở khóa (AD-01)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c_3" value="Quản trị viên (ADMIN)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
