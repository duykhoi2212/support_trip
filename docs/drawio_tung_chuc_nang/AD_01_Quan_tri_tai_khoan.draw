        <mxCell id="c_19" value="7. Cập nhật trạng thái tài khoản trên bảng quản trị sang ACTIVE" style="html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;endArrow=open;endFill=0;endSize=8;dashed=1;" edge="1" parent="1">
