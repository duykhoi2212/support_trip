# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG TRIỂN KHAI DOCKER (PRODUCTION)
# Sao chép file này thành `.env` tại thư mục gốc dự án trước khi chạy:
#   cp .env.docker.example .env
# ============================================================

# Cổng public ra bên ngoài (80 khi chạy trực tiếp hoặc 8080 nếu đặt sau Nginx Host + Certbot)
APP_PORT=80

# PostgreSQL Local Container (bỏ qua nếu dùng Neon Cloud DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=thay_doi_mat_khau_manh_tai_day
POSTGRES_DB=gox_db

# Chuỗi kết nối CSDL (Mặc định trỏ tới container postgres nội bộ)
DATABASE_URL=postgresql://postgres:thay_doi_mat_khau_manh_tai_day@postgres:5432/gox_db?schema=public

# Khóa bí mật JWT (Bắt buộc dài >= 32 ký tự ngẫu nhiên trên môi trường production)
JWT_SECRET=gox_super_secret_jwt_production_key_change_me_min_32_chars

# Thời hạn phiên đăng nhập
JWT_EXPIRES_IN=7d

# Google Gemini API Key cho tính năng tìm kiếm AI US-02 (Bỏ trống sẽ tự kích hoạt CS-05 Regex Fallback)
GEMINI_API_KEY=

# OpenRouteService API Key (Tùy chọn - hệ thống mặc định dùng OSRM miễn phí 100%)
ORS_API_KEY=

# Giới hạn dung lượng tải ảnh (MB)
MAX_FILE_SIZE_MB=5

# Cấu hình Email SMTP (Quên mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GoX <no-reply@gox.vn>"

# Địa chỉ tên miền Frontend (dùng cho liên kết đặt lại mật khẩu)
FRONTEND_URL=https://gox.yourdomain.vn
